{
  "name": "explore",
  "private": true,
  "version": "1.0.1",
  "license": "MIT",
  "description": "A Windows file manager with dual-pane browsing, workspaces, pinyin search and previews.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saramand9/prj-super-explore.git"
  },
  "homepage": "https://github.com/saramand9/prj-super-explore#readme",
  "bugs": {
    "url": "https://github.com/saramand9/prj-super-explore/issues"
  },
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "pnpm --filter @explore/desktop dev",
    "build": "pnpm --filter @explore/desktop build",
    "preview": "pnpm --filter @explore/desktop preview",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @explore/desktop test",
    "test:unit": "pnpm --filter @explore/desktop test:unit",
    "test:e2e": "pnpm --filter @explore/desktop test:e2e",
    "test:package": "pnpm --filter @explore/desktop test:package",
    "benchmark:scan": "pnpm --filter @explore/desktop benchmark:scan",
    "verify:search": "pnpm --filter @explore/desktop verify:search",
    "check:commits": "node scripts/check-commit-messages.mjs --ref HEAD",
    "test:commit-policy": "node --test scripts/tests/check-commit-messages.test.mjs",
    "test:release": "node --test scripts/tests/verify-release.test.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "pack:dir": "pnpm --filter @explore/desktop pack:dir",
    "pack:win": "pnpm --filter @explore/desktop run pack"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@lvce-editor/ripgrep",
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "^5.9.3"
  }
}
