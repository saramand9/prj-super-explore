{
  "name": "@explore/desktop",
  "version": "1.0.1",
  "license": "MIT",
  "description": "Explore for Windows: dual-pane file browsing, workspaces, search and previews.",
  "author": {
    "name": "大脚工作室"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "pnpm build && playwright test -c playwright.config.ts",
    "test:package": "pnpm pack:dir && playwright test -c playwright.package.config.ts",
    "benchmark:scan": "vitest run -c vitest.benchmark.config.ts",
    "verify:search": "node scripts/verify-search.mjs",
    "pack:dir": "pnpm build && pnpm verify:search && electron-builder --win --x64 --dir && node scripts/verify-search.mjs --packaged",
    "pack": "pnpm build && pnpm verify:search && electron-builder --win --x64 && node scripts/verify-search.mjs --packaged"
  },
  "build": {
    "appId": "com.explore.app",
    "productName": "Explore",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/prism_app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "out/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lvce-editor/ripgrep/bin/**/*"
    ]
  },
  "dependencies": {
    "@lvce-editor/ripgrep": "^4.1.0",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4",
    "pinyin-pro": "^3.28.1"
  },
  "devDependencies": {
    "@explore/shared": "workspace:*",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "^1.60.0",
    "@tanstack/react-virtual": "^3.10.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.400.0",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "zustand": "^5.0.0"
  }
}
