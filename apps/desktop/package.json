{
  "name": "@explore/desktop",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Explore for Windows: dual-pane file browsing, workspaces, search and previews.",
  "author": {
    "name": "大脚工作室"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/collect-licenses.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "pnpm build && playwright test -c playwright.config.ts",
    "test:package": "pnpm pack:dir && playwright test -c playwright.package.config.ts",
    "test:installer": "playwright test -c playwright.installer.config.ts",
    "benchmark:scan": "vitest run -c vitest.benchmark.config.ts",
    "verify:search": "node scripts/verify-search.mjs",
    "pack:dir": "pnpm build && pnpm verify:search && electron-builder --win --x64 --dir --publish never && node scripts/verify-search.mjs --packaged",
    "pack": "pnpm build && pnpm verify:search && electron-builder --win --x64 --publish never && node scripts/verify-search.mjs --packaged && node scripts/verify-update-assets.mjs"
  },
  "build": {
    "appId": "com.explore.app",
    "productName": "Explore",
    "artifactName": "Explore-Setup-${version}-windows-${arch}.${ext}",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "saramand9",
      "repo": "prj-super-explore",
      "private": false,
      "releaseType": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": "out/licenses",
        "to": "licenses/components"
      },
      {
        "from": "../../LICENSE",
        "to": "licenses/Explore-MIT-LICENSE.txt"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/prism_app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "out/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lvce-editor/ripgrep/bin/**/*"
    ]
  },
  "dependencies": {
    "@lvce-editor/ripgrep": "^4.1.0",
    "dompurify": "^3.4.17",
    "electron-updater": "6.8.11",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2",
    "pinyin-pro": "^3.29.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@explore/shared": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-virtual": "^3.14.23",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.400.0",
    "postcss": "^8.5.32",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "zustand": "^5.0.16"
  }
}
